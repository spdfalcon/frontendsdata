{
  "expo": {
    "name": "Sdata AI Chat",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Frame 2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Frame 2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Frame 2.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sdata.aichat"
    },
    "web": {
      "favicon": "./assets/Frame 2.png"
    },
    "extra": {
      "eas": {
        "projectId": "bb0fb5b7-c91b-4d6f-88a2-8ec5c3eefdd2"
      }
    },
    "fonts": {
      "KalamehFaNum": {
        "regular": "./assets/fonts/TTF/KalamehFaNum-Regular.ttf",
        "bold": "./assets/fonts/TTF/KalamehFaNum-Bold.ttf",
        "thin": "./assets/fonts/TTF/KalamehFaNum-Thin.ttf",
        "black": "./assets/fonts/TTF/KalamehFaNum-Black.ttf"
      }
    }
  }
}
